{
  "$schema": "https://raw.githubusercontent.com/andremjr/contentflow/main/docs/ecosystem/schemas/contentflow-plugin-v2.schema.json",
  "apiVersion": "2",
  "id": "com.contentflow.storyboard-preview",
  "name": "Prévia de Storyboard",
  "version": "1.1.0",
  "description": "Compõe programas visuais animados gerados por IA com a narração para prévia em tempo real, sem exportar vídeo.",
  "author": "André Marinho Jr.",
  "license": "MIT",
  "repository": "https://github.com/andremjr/plugins-contentflow",
  "runtime": { "kind": "node", "version": ">=26 <27", "module": "esm" },
  "minCoreVersion": "1.3.3",
  "entrypoint": "handler.mjs",
  "permissions": [],
  "capabilities": [{
    "id": "preview-storyboard",
    "name": "Montar prévia animada",
    "description": "Associa os planos e as composições animadas ao áudio para reprodução em tempo real na etapa de Edição.",
    "operator": "Código",
    "instructionUsage": "not_applicable",
    "blockTypes": ["CRIAR"],
    "processTypes": ["editing"],
    "inputPorts": [
      { "key": "plans", "label": "Planos normalizados", "required": true, "shape": { "kind": "content", "family": "text", "cardinality": "many", "representation": "inline" } },
      { "key": "animations", "label": "Composições animadas", "required": true, "shape": { "kind": "content", "family": "text", "cardinality": "many", "representation": "inline" } },
      { "key": "audio", "label": "Narração", "required": true, "shape": { "kind": "content", "family": "audio", "cardinality": "one", "representation": "artifact", "formats": { "mimeTypes": ["audio/mpeg"] } } }
    ],
    "outputPorts": [{ "key": "preview", "label": "Prévia animada", "required": true, "presentation": { "renderer": "storyboard-player" }, "shape": { "kind": "content", "family": "text", "cardinality": "one", "representation": "inline" } }],
    "execution": { "mode": "immediate", "defaultTimeoutMs": 30000, "supportsCancellation": true, "maxConcurrency": 4 },
    "sideEffects": [],
    "cost": { "model": "free", "estimateSupported": true },
    "dataPolicy": { "sendsDataToThirdParties": false },
    "blockConfigSchema": { "type": "object", "additionalProperties": false, "properties": {} },
    "outputSchema": { "type": "object", "additionalProperties": false, "properties": { "preview": { "type": "string", "minLength": 1 } }, "required": ["preview"] }
  }],
  "localizations": {
    "en": {
      "description": "Composes AI-generated animated scenes with narration for a real-time preview without exporting video.",
      "capabilities": { "preview-storyboard": {
        "name": "Build animated preview",
        "description": "Combines scene plans and animated compositions with audio for real-time playback in Editing.",
        "inputPorts": { "plans": { "label": "Normalized plans" }, "animations": { "label": "Animated compositions" }, "audio": { "label": "Narration" } },
        "outputPorts": { "preview": { "label": "Animated preview" } }
      } }
    },
    "es": {
      "description": "Combina escenas animadas generadas por IA con la narración para una vista previa en tiempo real sin exportar vídeo.",
      "capabilities": { "preview-storyboard": {
        "name": "Preparar vista previa animada",
        "description": "Combina los planes y las composiciones animadas con el audio para reproducirlos en tiempo real durante la edición.",
        "inputPorts": { "plans": { "label": "Planes normalizados" }, "animations": { "label": "Composiciones animadas" }, "audio": { "label": "Narración" } },
        "outputPorts": { "preview": { "label": "Vista previa animada" } }
      } }
    }
  }
}
