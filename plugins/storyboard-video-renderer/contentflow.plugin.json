{
  "$schema": "https://raw.githubusercontent.com/andremjr/contentflow/main/docs/ecosystem/schemas/contentflow-plugin-v2.schema.json",
  "apiVersion": "2",
  "id": "com.contentflow.storyboard-video-renderer",
  "name": "Renderizador de Vídeo de Storyboard",
  "version": "1.0.0",
  "description": "Renderiza a prévia vetorial do storyboard em MP4 local, com narração, legendas opcionais e aceleração H.264 quando disponível.",
  "author": "André Marinho Jr.",
  "license": "MIT",
  "repository": "https://github.com/andremjr/plugins-contentflow",
  "runtime": { "kind": "node", "version": ">=26 <27", "module": "esm" },
  "minCoreVersion": "1.3.3",
  "entrypoint": "handler.mjs",
  "permissions": ["filesystem:read", "filesystem:write", "process", "native"],
  "capabilities": [
    {
      "id": "render-storyboard-video",
      "name": "Renderizar storyboard em vídeo",
      "description": "Avança a composição quadro a quadro de modo determinístico e gera um MP4 sincronizado sem substituir a prévia interativa.",
      "operator": "Código",
      "instructionUsage": "not_applicable",
      "blockTypes": ["CRIAR"],
      "processTypes": ["editing"],
      "inputPorts": [
        {
          "key": "preview",
          "label": "Prévia animada",
          "description": "Manifesto produzido pelo Bloco de prévia do storyboard.",
          "required": true,
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "one",
            "representation": "inline"
          }
        },
        {
          "key": "audio",
          "label": "Narração",
          "required": true,
          "presentation": { "renderer": "audio-player" },
          "shape": {
            "kind": "content",
            "family": "audio",
            "cardinality": "one",
            "representation": "artifact",
            "formats": {
              "mimeTypes": ["audio/mpeg", "audio/wav", "audio/mp4", "audio/aac"]
            }
          }
        },
        {
          "key": "subtitles",
          "label": "Legendas SRT",
          "description": "Legenda opcional para queima no vídeo.",
          "required": false,
          "presentation": { "renderer": "file-list" },
          "shape": {
            "kind": "content",
            "family": "text",
            "cardinality": "many",
            "representation": "artifact",
            "formats": {
              "mimeTypes": [
                "application/x-subrip",
                "text/plain",
                "text/srt",
                "text/x-srt"
              ]
            }
          }
        }
      ],
      "outputPorts": [
        {
          "key": "video",
          "label": "Vídeo renderizado",
          "required": true,
          "presentation": { "renderer": "video-player" },
          "shape": {
            "kind": "content",
            "family": "video",
            "cardinality": "one",
            "representation": "artifact",
            "formats": { "mimeTypes": ["video/mp4"] }
          }
        }
      ],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 1800000,
        "supportsCancellation": true,
        "maxConcurrency": 1
      },
      "sideEffects": ["local_artifact", "subprocess"],
      "cost": { "model": "free", "estimateSupported": true },
      "dataPolicy": { "sendsDataToThirdParties": false },
      "blockConfigSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "width": {
            "type": "integer",
            "title": "Largura",
            "minimum": 320,
            "maximum": 1920,
            "default": 1280,
            "ui": { "section": "primary", "order": 1, "width": "half" }
          },
          "height": {
            "type": "integer",
            "title": "Altura",
            "minimum": 180,
            "maximum": 1080,
            "default": 720,
            "ui": { "section": "primary", "order": 2, "width": "half" }
          },
          "fps": {
            "type": "integer",
            "title": "Quadros por segundo",
            "enum": [24, 30, 60],
            "default": 30,
            "ui": { "section": "primary", "order": 3, "width": "half" }
          },
          "encoder": {
            "type": "string",
            "title": "Codificador H.264",
            "description": "Automático testa Intel QSV e usa software quando o hardware não está disponível.",
            "oneOf": [
              { "const": "auto", "title": "Automático" },
              { "const": "qsv", "title": "Intel Quick Sync" },
              { "const": "software", "title": "Software" }
            ],
            "default": "auto",
            "ui": { "section": "primary", "order": 4, "width": "half" }
          },
          "bitrateMbps": {
            "type": "integer",
            "title": "Bitrate de vídeo (Mbps)",
            "minimum": 2,
            "maximum": 20,
            "default": 8,
            "ui": { "section": "advanced", "order": 5, "width": "half" }
          },
          "burnSubtitles": {
            "type": "boolean",
            "title": "Queimar legendas no vídeo",
            "default": false,
            "ui": { "section": "primary", "order": 6, "width": "full" }
          }
        },
        "required": [
          "width",
          "height",
          "fps",
          "encoder",
          "bitrateMbps",
          "burnSubtitles"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "video": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "mimeType": { "const": "video/mp4" },
              "size": { "type": "integer", "minimum": 1 },
              "url": { "type": "string", "pattern": "^artifact://" }
            },
            "required": ["id", "name", "mimeType", "size", "url"]
          }
        },
        "required": ["video"]
      }
    }
  ],
  "localizations": {
    "en": {
      "description": "Renders the vector storyboard preview to a local MP4 with narration, optional subtitles, and hardware H.264 acceleration when available.",
      "capabilities": {
        "render-storyboard-video": {
          "name": "Render storyboard video",
          "description": "Advances the composition frame by frame deterministically and generates a synchronized MP4 without replacing the interactive preview.",
          "inputPorts": {
            "preview": {
              "label": "Animated preview",
              "description": "Manifest produced by the storyboard preview Block."
            },
            "audio": { "label": "Narration" },
            "subtitles": {
              "label": "SRT subtitles",
              "description": "Optional subtitles to burn into the video."
            }
          },
          "outputPorts": { "video": { "label": "Rendered video" } },
          "blockConfigSchema": {
            "properties": {
              "width": { "title": "Width" },
              "height": { "title": "Height" },
              "fps": { "title": "Frames per second" },
              "encoder": {
                "title": "H.264 encoder",
                "description": "Auto tests Intel QSV and uses software when hardware is unavailable.",
                "options": [
                  { "value": "auto", "label": "Auto" },
                  { "value": "qsv", "label": "Intel Quick Sync" },
                  { "value": "software", "label": "Software" }
                ]
              },
              "bitrateMbps": { "title": "Video bitrate (Mbps)" },
              "burnSubtitles": { "title": "Burn subtitles into video" }
            }
          }
        }
      }
    },
    "es": {
      "description": "Renderiza la vista previa vectorial del storyboard en un MP4 local con narración, subtítulos opcionales y aceleración H.264 cuando está disponible.",
      "capabilities": {
        "render-storyboard-video": {
          "name": "Renderizar storyboard en video",
          "description": "Avanza la composición cuadro a cuadro de forma determinista y genera un MP4 sincronizado sin sustituir la vista previa interactiva.",
          "inputPorts": {
            "preview": {
              "label": "Vista previa animada",
              "description": "Manifiesto producido por el Bloque de vista previa del storyboard."
            },
            "audio": { "label": "Narración" },
            "subtitles": {
              "label": "Subtítulos SRT",
              "description": "Subtítulos opcionales para incrustar en el video."
            }
          },
          "outputPorts": { "video": { "label": "Video renderizado" } },
          "blockConfigSchema": {
            "properties": {
              "width": { "title": "Ancho" },
              "height": { "title": "Alto" },
              "fps": { "title": "Fotogramas por segundo" },
              "encoder": {
                "title": "Codificador H.264",
                "description": "Automático prueba Intel QSV y usa software cuando el hardware no está disponible.",
                "options": [
                  { "value": "auto", "label": "Automático" },
                  { "value": "qsv", "label": "Intel Quick Sync" },
                  { "value": "software", "label": "Software" }
                ]
              },
              "bitrateMbps": { "title": "Bitrate de video (Mbps)" },
              "burnSubtitles": { "title": "Incrustar subtítulos en el video" }
            }
          }
        }
      }
    }
  }
}
